{
  "name": "hoopo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "docker compose --profile e2e run --rm playwright"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "supabase": "^2.111.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
