# ローカル開発用の環境変数。cp .env.example .env して使う(.env はコミットしない)
# 値は `pnpm exec supabase start` の出力(または `pnpm exec supabase status`)で確認できる
#
# ホスト名の使い分け:
# - アプリは Docker コンテナ内で動くため、ホスト側の Supabase スタックへは
#   `host.docker.internal` で到達する(compose.yml の extra_hosts で解決される)
# - ホストから直接叩く場合(drizzle-kit 等のCLI)は localhost に読み替える

# Supabase ローカルスタック
SUPABASE_URL=http://host.docker.internal:54321
# DATABASE_URL はマイグレーション・シード用(所有者ロール)。db:migrate / db:seed は
# ローカル以外への接続を拒否する(prod 誤爆防止。クラウドは db:migrate:stg 等の環境明示スクリプト)
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
# APP_DATABASE_URL はアプリ・Integration テスト用(RLS が効く hoopo_app 系ロール)。
# ローカルのログインロール hoopo_app_local は db:seed / test:int が冪等に自動作成する
APP_DATABASE_URL=postgresql://hoopo_app_local:postgres@host.docker.internal:54322/postgres
# ローカル Supavisor(54329)経由の GUC 残留テストを回す場合のみ設定(任意)。
# ローカルのプーラは登録済みユーザーが pgbouncer.pooler-dev のみ(カスタムロール不可)
# APP_POOLER_DATABASE_URL=postgresql://pgbouncer.pooler-dev:postgres@localhost:54329/postgres
# stg の接続文字列は .env ではなく .env.stg 等の別ファイルに置く(誤読み込み防止・コミット禁止)。
# クラウド接続は必ず Supavisor(transaction mode, 6543)経由。直結(5432)は IPv6 専用で
# IPv4 直結は有料 add-on になるため使わない
# STG_DATABASE_URL=
# prod の接続文字列は .env.prod に置く(db:migrate:prod だけが .env.prod を読む。コミット禁止。
# 適用手順は docs/DEVELOPMENT.md「prod マイグレーション適用」)
# PROD_DATABASE_URL=
# anon key / service_role key は supabase status の出力からコピーする
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LINE(フェーズ1で設定。シークレットは絶対にコミットしない)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LIFF_ID=
# LINE ログインチャネルの Channel ID(ID トークンの verify API に渡す。#9 で取得)
LINE_CHANNEL_ID=
# LIFF ID(クライアント側の liff.init 用。#9 で取得)
NEXT_PUBLIC_LIFF_ID=

# 認証・セッション(縦切り1a)
# 当面の単一チーム(ローカルはシードの SKC 固定 id。stg/prod は teams の実 id)
TEAM_ID=00000000-0000-4000-8000-000000000001
# 鍵はすべて 64 桁 hex(32 バイト)。`openssl rand -hex 32` で生成し、環境ごとに別の値にする
SESSION_SECRET=1111111111111111111111111111111111111111111111111111111111111111
LINE_ID_ENCRYPTION_KEY=2222222222222222222222222222222222222222222222222222222222222222
LINE_ID_HMAC_KEY=3333333333333333333333333333333333333333333333333333333333333333
# フェイク認証(ローカル/E2E 専用。本番では起動時に拒否される)。実チャネル取得(#9)後は外す
AUTH_FAKE=1
NEXT_PUBLIC_AUTH_FAKE=1
