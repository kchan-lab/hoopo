# ローカル開発用の環境変数。cp .env.example .env して使う(.env はコミットしない)
# 値は `pnpm exec supabase start` の出力(または `pnpm exec supabase status`)で確認できる
#
# ホスト名の使い分け:
# - アプリは Docker コンテナ内で動くため、ホスト側の Supabase スタックへは
#   `host.docker.internal` で到達する(compose.yml の extra_hosts で解決される)
# - ホストから直接叩く場合(drizzle-kit 等のCLI)は localhost に読み替える

# Supabase ローカルスタック
SUPABASE_URL=http://host.docker.internal:54321
# DATABASE_URL はマイグレーション・シード用(所有者ロール)。db:migrate / db:seed は
# ローカル以外への接続を拒否する(prod 誤爆防止。クラウドは db:migrate:stg 等の環境明示スクリプト)
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
# APP_DATABASE_URL はアプリ・Integration テスト用(RLS が効く hoopo_app 系ロール。PR-B で使用)
APP_DATABASE_URL=
# stg の接続文字列は .env ではなく .env.stg 等の別ファイルに置く(誤読み込み防止・コミット禁止)。
# クラウド接続は必ず Supavisor(transaction mode, 6543)経由。直結(5432)は IPv6 専用で
# IPv4 直結は有料 add-on になるため使わない
# STG_DATABASE_URL=
# anon key / service_role key は supabase status の出力からコピーする
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LINE(フェーズ1で設定。シークレットは絶対にコミットしない)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LIFF_ID=
