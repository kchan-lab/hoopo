# ローカル開発用の環境変数。cp .env.example .env して使う(.env はコミットしない)
# 値は `pnpm exec supabase start` の出力(または `pnpm exec supabase status`)で確認できる

# Supabase ローカルスタック
SUPABASE_URL=http://localhost:54321
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# anon key / service_role key は supabase status の出力からコピーする
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LINE(フェーズ1で設定。シークレットは絶対にコミットしない)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LIFF_ID=
